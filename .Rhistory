library(readxl)
YouTube_Comments_Sentiment_Analysis_r <- read_excel("YouTube_Comments_Sentiment_Analysis_r.xlsx")
View(YouTube_Comments_Sentiment_Analysis_r)
# 步驟一：文字清洗 (Text Cleaning)
# 文本常含有網址、時間(02:05)、表情符號，這些會干擾機率計算，必須先剔除。
clean_text <- df %>%
# 建立唯一識別碼
mutate(doc_id = row_number()) %>%
# 移除非必要的字元
mutate(text_clean = text %>%
str_remove_all("https?://[A-Za-z0-9./]+") %>% # 刪除網址
str_remove_all("[0-9]{2}:[0-9]{2}") %>%       # 刪除時間 (如 25:25)
str_remove_all("[A-Za-z0-9_：:.,，。！!？?（）()\"「」『』#@—X]") %>% # 刪除英數字、標點與特定符號
str_trim()) %>%                               # ✨ 修正：刪除前後多餘空白
# 篩選掉清洗後變成空值的列，並將標籤轉為 Factor
filter(text_clean != "") %>%
mutate(sentiment_label = as.factor(sentiment_label))
