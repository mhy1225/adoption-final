# 4. 執行批次抓取
final_results_list <- lapply(video_ids, get_youtube_comments, key = api_key)
final_df <- rbindlist(final_results_list, fill = TRUE)
# 5. 修正後的存檔代碼
# 使用 file.path 會自動處理斜線問題，並將檔案直接存在「目前的工作目錄」下
file_name <- sprintf("YouTube_Comments_%s.csv", Sys.Date())
# 建議先存成目前目錄，如果你一定要存桌面，可以手動複製路徑
write.csv(final_df, file_name, row.names = FALSE, fileEncoding = "UTF-8")
message(paste("\n任務完成！檔案已存為：", file_name))
message(paste("儲存路徑在：", getwd())) # 這行會告訴你檔案實際在哪裡
##取得 YouTube API Key 的過程需要透過 Google Cloud Console。
##第一步：進入 Google Cloud 控制台
#前往 Google Cloud Console。
#登入你的 Google 帳號。
##第二步：建立新專案 (Project)
#在頁面左上角（Google Cloud 標誌旁邊），點擊專案下拉選單。
#點擊右上角的 「新增專案」(New Project)。
#輸入專案名稱（例如：My-YouTube-Research），然後點擊 「建立」。
#建立完成後，請確保目前的選單切換到該專案下。
##第三步：啟用 YouTube Data API v3
#在左側選單中，點擊 「API 和服務」 (APIs & Services) > 「程式庫」 (Library)。
#在搜尋框輸入 「YouTube Data API v3」。
#點擊搜尋結果中的 YouTube Data API v3。
#點擊 「啟用」 (Enable)。這一步非常重要，沒啟用 API，金鑰將無法運作。
##第四步：建立 API 金鑰 (Credentials)
#啟用後，頁面會跳轉到 API 管理介面。點擊左側的 「憑證」 (Credentials)。
#點擊上方的 「+ 建立憑證」 (+ Create Credentials)。
#選擇 「API 金鑰」 (API key)。
#系統會跳出一個視窗，顯示你的 API Key（例如：AIzaSy...）。請將這串文字複製下來，這就是你要貼回 R 程式碼中的內容。
# 重要安全建議：設定金鑰限制
#為了防止他人盜用你的 API 金鑰導致配額被耗盡，強烈建議進行以下設定：
#在金鑰建立後的視窗中，點擊 「編輯金鑰」(Edit API key)。
#API 限制 (API restrictions)：
#選擇「限制金鑰」(Restrict key)。
#在下拉選單中勾選 「YouTube Data API v3」 並點擊確定。
#這樣這組金鑰就只能用於抓取 YouTube 資料。
#點擊 「儲存」。
#抓取YouTube影片留言
library(httr)
library(jsonlite)
library(data.table)
# 1. 基本設定
api_key <- "AIzaSyA9XQNxXIP6XjT2qgCfhP7g6YZeCWd5rJw"
video_ids <- c("y-Dlic9Mqo4", "oPuF0KqgvTg", "uznUMt_-Z0Q")
# 2. 定義獲取影片標題的函數
get_video_title <- function(v_id, key) {
url <- "https://www.googleapis.com/youtube/v3/videos"
res <- GET(url, query = list(part = "snippet", id = v_id, key = key))
if (status_code(res) == 200) {
content <- fromJSON(rawToChar(res$content))
if (length(content$items) > 0) return(content$items$snippet$title)
}
return("Unknown Title")
}
# 3. 定義留言抓取函數
get_youtube_comments <- function(v_id, key) {
v_title <- get_video_title(v_id, key)
all_pages <- list()
next_token <- ""
page_count <- 1
message(paste("\n--- 正在處理影片:", v_title, "---"))
repeat {
message(paste("  正在抓取第", page_count, "頁..."))
url <- "https://www.googleapis.com/youtube/v3/commentThreads"
res <- GET(url, query = list(
part = "snippet",
maxResults = 100,
videoId = v_id,
key = key,
pageToken = next_token
))
if (status_code(res) != 200) break
content <- fromJSON(rawToChar(res$content))
if (is.null(content$items) || length(content$items) == 0) break
snippet <- content$items$snippet$topLevelComment$snippet
# --- 字數處理與清洗 ---
# 移除 HTML 標籤（如 <br>），避免影響字數計算準確度
clean_text <- gsub("<br\\s*/?>", " ", snippet$textDisplay) # 換行轉空格
clean_text <- gsub("<.*?>", "", clean_text)              # 移除其餘 HTML 標籤
df_page <- data.frame(
video_title = v_title,
video_id = v_id,
author = snippet$authorDisplayName,
text = clean_text,
text_length = nchar(clean_text), # 🚩 新增：計算字數欄位
likes = snippet$likeCount,
time = snippet$publishedAt,
stringsAsFactors = FALSE
)
all_pages[[page_count]] <- df_page
next_token <- content$nextPageToken
if (is.null(next_token) || next_token == "") break
Sys.sleep(0.5)
page_count <- page_count + 1
}
return(rbindlist(all_pages, fill = TRUE))
}
# 4. 執行批次抓取
final_results_list <- lapply(video_ids, get_youtube_comments, key = api_key)
final_df <- rbindlist(final_results_list, fill = TRUE)
# 5. 修正後的存檔代碼
# 使用 file.path 會自動處理斜線問題，並將檔案直接存在「目前的工作目錄」下
file_name <- sprintf("YouTube_Comments_%s.csv", Sys.Date())
# 建議先存成目前目錄，如果你一定要存桌面，可以手動複製路徑
# 將 UTF-8 改為 UTF-8-BOM
write.csv(final_df, file_name, row.names = FALSE, fileEncoding = "UTF-8-BOM")
